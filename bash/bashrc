#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

export PATH="$PATH:$HOME/.spicetify"
alias vim="NVIM_APPNAME=nvimLazyvim nvim"
alias rstudio="flatpak run org.vinegarhq.Vinegar"
alias roblox="flatpak run org.vinegarhq.Sober"
export PATH="$HOME/.local/bin:$PATH"
eval "$(starship init bash)"
fastfetch

# Kurapika theme: restore normal colors when outside root
__kurapika_theme() {
    printf '\e]10;#FFFFFF\a'
}

PROMPT_COMMAND="__kurapika_theme${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

sudo() {
    if [[ "$#" -eq 1 && "$1" == "su" ]]; then
        command sudo su
        fastfetch
    else
        command sudo "$@"
    fi
}
